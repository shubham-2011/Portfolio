# PostgreSQL (Neon Tech / Cloud Postgres) Connection URI
POSTGRES_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# Admin Master Password for /admin CMS Portal
ADMIN_PASSWORD=use_a_long_unique_password

# Generate a 32+ character random value; never commit the real value.
ADMIN_SESSION_SECRET=use_a_random_32_character_or_longer_secret

# MongoDB Connection URI (optional contact-form backup)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Cloudinary image storage (used by the admin image-upload controls)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini API Key (Optional: for AI Chatbot Generation & text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key
